# -----------------------------------------------------------------------------
# Environment variables for the portfolio app.
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# NEVER commit real secrets. On Vercel, set these in Project Settings → Environment
# Variables instead of committing a file.
#
# In a local `.env`/`.env.local` file, Next.js expands `$VAR` sequences. bcrypt
# hashes contain `$`, so escape each `$` as `\$` in a local file (values pasted
# into the Vercel dashboard are used as-is and need no escaping). Or use the
# base64 variant below, which contains no `$`.
# -----------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# MongoDB connection string (Atlas: mongodb+srv://... ; local: mongodb://...).
MONGODB_URI=""

# --- Admin authentication (required; login is refused if these are missing) --
# The single admin username.
ADMIN_USERNAME=""
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'YOUR_PASSWORD'
# In a local .env file escape each '$' as '\$'. Leave empty to instead use the
# base64 form below.
ADMIN_PASSWORD_HASH=""
# Optional: base64-encoded bcrypt hash (avoids '$' escaping entirely). Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1],10)).toString('base64'))" 'YOUR_PASSWORD'
# If set, this takes precedence over ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD_HASH_B64=""
# Secret used to sign the admin session cookie (HS256). Required, minimum 32
# characters. Generate with: openssl rand -base64 48
JWT_SECRET=""

# --- Contact form email (SMTP) ----------------------------------------------
# Required for the contact form to send email. If unset, the contact endpoint
# returns a 503 and logs no secrets.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Address that receives contact-form notifications.
CONTACT_EMAIL=""

# --- Cloudflare R2 (image upload / listing) ---------------------------------
# Required for admin image uploads and the image library.
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
# Public base URL of the bucket (public identifier, not a secret).
CLOUDFLARE_R2_PUBLIC_URL=""

# --- Search engine verification (public identifiers, not secrets) -----------
GOOGLE_SITE_VERIFICATION=""
BING_VERIFICATION=""
YANDEX_VERIFICATION=""
